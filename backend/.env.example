# Database Configuration
# Database
DB_PASSWORD=secure_password
# Production (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://admin:secure_password@postgres/resource_marketplace
# Local Development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./ibooks.db
DB_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_MIN_LENGTH=8

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Application Settings
APP_NAME=Resource Marketplace
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=true

# Monitoring Flags
MONITOR_PERFORMANCE=true
MONITOR_AUDIT=true
MONITOR_API_LOG=true
MONITOR_SYSTEM_METRICS=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_ACCESS=true
LOG_ERROR=true
LOG_PERFORMANCE=true
LOG_AUDIT=true
LOG_DIR=/app/logs
LOG_FORMAT=json

# SEO Configuration
SEO_AUTO_GENERATE=true
SEO_SUBMIT_BAIDU=false
SEO_SUBMIT_GOOGLE=false
SEO_SUBMIT_360=false
BAIDU_API_KEY=
GOOGLE_API_KEY=
SITE_URL=https://www.example.com
STATIC_PAGES_DIR=/app/static_pages

# Email Configuration (for registration/notifications)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=noreply@example.com
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/app/uploads

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Performance Thresholds
SLOW_QUERY_THRESHOLD_MS=500
