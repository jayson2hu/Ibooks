# Local backend development template. Production values belong in the
# deployment secret store or the root Compose .env file.

# Database (SQLite for local development)
DATABASE_URL=sqlite+aiosqlite:///./ibooks.db
DB_ECHO=false
# Local/test compatibility only. Production and Docker must keep this false
# and run `alembic upgrade head` before starting the API.
SCHEMA_BOOTSTRAP_ENABLED=true

# Redis Configuration
# Use explicit IPv4 for a backend run directly on Windows; localhost may resolve
# to IPv6 while the local Redis instance listens only on 127.0.0.1.
REDIS_URL=redis://127.0.0.1:6379/0

# Security (the published value is deliberately rejected when DEBUG=false)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Application Settings
APP_NAME=Resource Marketplace
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=true

# Monitoring Flags
MONITOR_PERFORMANCE=true
MONITOR_AUDIT=true
MONITOR_API_LOG=true
MONITOR_SYSTEM_METRICS=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_ACCESS=true
LOG_ERROR=true
LOG_PERFORMANCE=true
LOG_AUDIT=true
LOG_DIR=logs
LOG_FORMAT=json

# SEO Configuration
SEO_AUTO_GENERATE=true
SEO_SUBMIT_BAIDU=false
SEO_SUBMIT_GOOGLE=false
SEO_SUBMIT_360=false
BAIDU_API_KEY=
GOOGLE_API_KEY=
SITE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
STATIC_PAGES_DIR=static_pages

# Email Configuration (for registration/notifications)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true

# Alipay coin recharge. Credentials are optional for ordinary local browsing,
# but all three are required to exercise the recharge flow. PEM keys may use
# literal \n separators on one line.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=true

# File Upload
# Maximum file size in bytes (10 MiB by default)
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Performance Thresholds
SLOW_QUERY_THRESHOLD_MS=500
