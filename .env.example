# Docker Compose environment template
#
# Copy this file to .env and fill every required value. Compose intentionally
# refuses to start while secrets or public URLs are empty. Generate unique
# values; never reuse values between environments.

# Required service secrets (for example: `openssl rand -hex 32`)
DB_PASSWORD=
JWT_SECRET_KEY=
GRAFANA_PASSWORD=

# Public production URLs (required; do not add a trailing slash).
SITE_URL=
API_PUBLIC_URL=
CORS_ORIGINS=

# Application and logging
DEBUG=false
LOG_LEVEL=INFO
CRAWLER_SCHEDULER_ENABLED=true

# Host bindings. Loopback defaults assume a reverse proxy on the same host;
# explicitly use 0.0.0.0 only when direct network exposure is intentional.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
MONITORING_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Local observability storage limits and Docker json-file rotation. Loki
# retention must be at least 24h.
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=168h
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# SEO and search-engine submission. BAIDU_API_KEY is only required when
# SEO_SUBMIT_BAIDU=true.
SEO_AUTO_GENERATE=true
SEO_SUBMIT_BAIDU=false
SEO_SUBMIT_GOOGLE=false
SEO_SUBMIT_360=false
BAIDU_API_KEY=
GOOGLE_API_KEY=

# Email. Registration can run without SMTP, but verification/reset delivery
# is unavailable until sender credentials are configured.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true

# Alipay coin recharge. Keep sandbox mode explicit. The three credential
# values are required before the recharge endpoint can create a payment.
# Store PEM keys on one line with literal \n separators.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=true
